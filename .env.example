# 供应商：mock（离线、确定性）| deepseek
NOVEL_PROVIDER=mock

# DeepSeek 接入（provider=deepseek 时必填）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可用模型以 GET /models 为准（实测：deepseek-flash、deepseek-v4-pro）
# 模型名写错会直接 400
# NOVEL_MODEL_ARCHITECT=deepseek-flash
# NOVEL_MODEL_PLANNER=deepseek-flash
# NOVEL_MODEL_WRITER=deepseek-flash
# NOVEL_MODEL_CRITIC=deepseek-flash
# NOVEL_MODEL_COMPRESS=deepseek-flash

# 可选：超时与重试
# NOVEL_TIMEOUT=180
# NOVEL_RETRIES=2

# 可选：单次 writer 调用的上下文预算（token，保守估算）
# NOVEL_CONTEXT_BUDGET=6000

# 可选：Critic 评审与改写
# NOVEL_REVIEW=1              # 0 关闭评审
# NOVEL_REVIEW_THRESHOLD=7.5  # 低于此分才改写
# NOVEL_MAX_REWRITES=1        # 最多改写几轮

# 可选：版本历史保留策略（全量快照，几百章会撑大数据库）
# NOVEL_HISTORY_RECENT=30     # 保留最近多少版
# NOVEL_HISTORY_EVERY=50      # 更早的版本每多少版留一个锚点
